{
  "name": "library-search",
  "productName": "Library Search",
  "version": "0.1.1",
  "description": "Offline search for the Community Rebuild Library (books + Kiwix ZIMs)",
  "author": "Bogdan Vidican",
  "license": "MIT",
  "private": true,
  "main": "build/main/main.js",
  "desktopName": "library-search.desktop",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "serve": "node scripts/build.mjs && node build/server/server.js --mode browser --open-browser",
    "index": "node scripts/build.mjs && node build/indexer/indexer.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dist:linux-ia32": "node scripts/package.mjs --arch ia32",
    "dist:mac": "node scripts/package.mjs --platform darwin --arch arm64",
    "test:ia32": "bash scripts/docker-ia32-test.sh",
    "self-test": "node scripts/build.mjs && electron . --self-test"
  },
  "dependencies": {
    "node-sqlite3-wasm": "0.8.60"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "16.18.126",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "17.4.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "lucide-react": "1.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
